CONFIG_TARGET_ROOTFS_PARTSIZE=360
CONFIG_TARGET_ROOTFS_TARGZ=y
CONFIG_PACKAGE_kmod-tcp-bbr=y
CONFIG_PACKAGE_kmod-mhi-bus=y
CONFIG_PACKAGE_kmod-mhi-net=y
CONFIG_PACKAGE_mount-utils=y
CONFIG_PACKAGE_wget-ssl=y
# ====== iStore 集成（修复依赖满足问题）======
# 1) 商店本体
CONFIG_PACKAGE_luci-app-store=y
# 2) Lua LuCI 兼容层（iStore 是 Lua 程序，必须有）
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-lua-runtime=y
CONFIG_PACKAGE_luci-lib-ipkg=y
# 3) iStore 运行时依赖链（缺任何一个都会被 Kconfig 静默丢弃）
CONFIG_PACKAGE_luci-lib-taskd=y
CONFIG_PACKAGE_luci-lib-xterm=y
CONFIG_PACKAGE_taskd=y
# 4) 关键冲突：必须用 dnsmasq-full，iStore 依赖它的 ipset/nftset 功能
#    务必先 n 掉 dnsmasq，再 y 上 dnsmasq-full，否则 Kconfig 会判定冲突并静默丢弃 luci-app-store
CONFIG_PACKAGE_dnsmasq=n
CONFIG_PACKAGE_dnsmasq-full=y
# 5) iStore 常用基础依赖（建议带上，避免商店里装插件时再缺）
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_zoneinfo-asia=y
CONFIG_PACKAGE_kmod-tun=y
