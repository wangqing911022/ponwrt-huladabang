CONFIG_TARGET_ROOTFS_PARTSIZE=360
CONFIG_TARGET_ROOTFS_TARGZ=y
CONFIG_PACKAGE_kmod-tcp-bbr=y
CONFIG_PACKAGE_kmod-mhi-bus=y
CONFIG_PACKAGE_kmod-mhi-net=y
CONFIG_PACKAGE_mount-utils=y
CONFIG_PACKAGE_wget-ssl=y

# ====== iStore 商店集成（补全全部依赖，防止 Kconfig 静默丢弃）======

# 1) 商店本体
CONFIG_PACKAGE_luci-app-store=y

# 2) Lua LuCI 兼容层（ImmortalWrt 25.12+ 已是 JS LuCI，Lua 程序必须显式开）
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-lua-runtime=y
CONFIG_PACKAGE_luci-lib-ipkg=y

# 3) iStore 终端/任务子系统（taskd 是 iStore 安装/执行任务的核心守护进程）
CONFIG_PACKAGE_luci-lib-xterm=y
CONFIG_PACKAGE_luci-lib-taskd=y
CONFIG_PACKAGE_taskd=y

# 4) taskd 的运行时依赖（上一版漏了这三个，导致 taskd 被 defconfig 静默丢弃，整条链路报废）
#    来自 taskd/Makefile: DEPENDS:=+procd +script-utils +coreutils +coreutils-stty
#    这就是固件编译通过但 iStore 没出现在 LuCI 里的直接根因
CONFIG_PACKAGE_script-utils=y
CONFIG_PACKAGE_coreutils=y
CONFIG_PACKAGE_coreutils-stty=y

# 5) 基础依赖
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_tar=y
CONFIG_PACKAGE_zoneinfo-asia=y
CONFIG_PACKAGE_kmod-tun=y
